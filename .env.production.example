# ==============================================================================
# SentinelWP Enterprise Production Environment Configuration Template
# COPY TO: .env.production
# PERMISSIONS: chmod 600 .env.production
# NOTE: All placeholder values starting with 'REPLACE_WITH_' must be populated
# with high-entropy cryptographically secure random values before deployment.
# Services will refuse to start if default or placeholder values are detected.
# ==============================================================================

# Core Application Environment
ENVIRONMENT=production
PORT=8080
HOST=0.0.0.0

# Ingress & Gateway Host Ports (Published by Nginx only)
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Reverse Proxy & Trusted Hop Count (Werkzeug ProxyFix)
WSA_BEHIND_PROXY=true
WSA_PROXY_X_FOR=1
WSA_PROXY_X_PROTO=1
WSA_PROXY_X_HOST=1
WSA_PROXY_X_PORT=1
WSA_PROXY_X_PREFIX=0

# Session & Authentication Hardening
# Generate with: openssl rand -hex 32
WSA_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_KEY_FOR_PRODUCTION
WSA_SESSION_COOKIE_SECURE=true
WSA_SESSION_COOKIE_SAMESITE=Lax
WSA_SESSION_EXPIRY_HOURS=8

# Initial Bootstrap Administrator (Enforces strong password policy via setup wizard)
# Must be at least 12 characters. Used only when programmatic bootstrap is configured.
WSA_ADMIN_USERNAME=sentinel_admin
WSA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_AT_LEAST_14_CHARS!

# PostgreSQL 16 Enterprise Relational Persistence
POSTGRES_DB=sentinelwp
POSTGRES_USER=sentinelwp_user
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD_FOR_PROD
DATABASE_URL=postgresql+psycopg://sentinelwp_user:${POSTGRES_PASSWORD}@postgres:5432/sentinelwp

# Redis 7 Enterprise Task Broker, Result Backend & Rate Limiter
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD_FOR_PROD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# Task Execution Backend & Worker Concurrency
SCAN_EXECUTION_BACKEND=celery
WORKER_SCAN_CONCURRENCY=4
WORKER_INTEL_CONCURRENCY=2

# SSRF Protection & Target Security
# In production, private/internal IP targets are strictly prohibited.
WSA_ALLOW_PRIVATE_TARGETS=false
WSA_STRICT_DNS=true
# Test allowlist is strictly ignored/rejected in production mode fail-closed
WSA_TEST_TARGET_ALLOWLIST=
# Scanner TLS: default false so misconfigured HTTPS targets can still be assessed (headers/TLS findings).
# Set true when all scan targets present valid public certificates.
WSA_SCANNER_TLS_VERIFY=false

# External Threat Intelligence API Keys (Optional but recommended)
WORDFENCE_API_KEY=
NVD_API_KEY=

# Retention & Data Lifecycle
SCAN_JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
INTEL_FRESHNESS_SLA_HOURS=24.0

# Database & Redis Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
REDIS_POOL_MAX_CONNECTIONS=50
