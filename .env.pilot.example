# SentinelWP Sprint 9 Pilot Environment Example Configuration
# Copy to .env.pilot or export as environment variables before starting pilot containers.

# PostgreSQL 16 Isolated Credentials
PILOT_POSTGRES_DB=sentinelwp_pilot
PILOT_POSTGRES_USER=pilot_user
PILOT_POSTGRES_PASSWORD=pilot_dev_password_123

# MariaDB 10.5 Synthetic Credentials (WordPress Lab)
PILOT_MARIADB_ROOT_PASSWORD=pilot_root_pass
PILOT_MARIADB_DATABASE=wordpress
PILOT_MARIADB_USER=wp_pilot
PILOT_MARIADB_PASSWORD=wp_pilot_pass

# Test User Credentials for Pilot Browser E2E Tests
PILOT_ADMIN_PASSWORD=PilotAdminPass2026!
PILOT_ANALYST_PASSWORD=PilotAnalystPass2026!
PILOT_VIEWER_PASSWORD=PilotViewerPass2026!

# Test Target Allowlist for Laboratory Scanning
WSA_TEST_TARGET_ALLOWLIST=127.0.0.1:8099,pilot-wordpress
