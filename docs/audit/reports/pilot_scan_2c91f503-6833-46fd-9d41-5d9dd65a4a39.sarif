                  "configuration"
                ]
              }
            },
            {
              "id": "SENTINEL-AUTHENTICATION-9251",
              "name": "XML-RPCsystem.multicallAvailable",
              "shortDescription": {
                "text": "XML-RPC system.multicall Available"
              },
              "fullDescription": {
                "text": "system.multicall is enabled, allowing attackers to attempt thousands of password guesses in a single HTTP request. Total methods available: 80."
              },
              "help": {
                "text": "Disable XML-RPC or specifically block system.multicall. Use a security plugin to disable multicall or rate-limit attempts."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "authentication"
                ]
              }
            },
            {
              "id": "SENTINEL-EXPOSURE-9625",
              "name": "XML-RPCPingbackAvailable(DDoSVector)",
              "shortDescription": {
                "text": "XML-RPC Pingback Available (DDoS Vector)"
              },
              "fullDescription": {
                "text": "pingback.ping method is available. This can be abused for DDoS amplification and internal port scanning (SSRF)."
              },
              "help": {
                "text": "Disable pingbacks: add_filter('xmlrpc_methods', function($methods) { unset($methods['pingback.ping']); return $methods; });"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "exposure"
                ]
              }
            },
            {
              "id": "SENTINEL-ENUMERATION-9512",
              "name": "XML-RPCUserMethodsAvailable",
