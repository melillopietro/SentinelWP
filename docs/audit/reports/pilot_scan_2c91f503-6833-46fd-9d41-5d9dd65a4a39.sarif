{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SentinelWP",
          "version": "3.6.0",
          "informationUri": "https://github.com/melillopietro/SentinelWP",
          "rules": [
            {
              "id": "SENTINEL-INFORMATION_DISCLOSURE-5915",
              "name": "WordPressCMSDetected",
              "shortDescription": {
                "text": "WordPress CMS Detected"
              },
              "fullDescription": {
                "text": "WordPress detected at http://127.0.0.1:8099 (confidence: 100%) — Version: 6.4.3 (source: meta_generator, reliability: high)"
              },
              "help": {
                "text": "Remove version meta tags and generator references from page source."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "information_disclosure"
                ]
              }
            },
            {
              "id": "SENTINEL-INFORMATION_DISCLOSURE-0580",
              "name": "WordPressVersionExposed:6.4.3",
              "shortDescription": {
                "text": "WordPress Version Exposed: 6.4.3"
              },
              "fullDescription": {
                "text": "WordPress version (6.4.3) is publicly visible. Source: meta_generator (reliability: high). This enables targeted exploit research."
              },
              "help": {
                "text": "Remove the generator meta tag. Use security plugins to hide version info."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "information_disclosure"
                ]
              }
            },
            {
              "id": "SENTINEL-ENUMERATION-3646",
              "name": "RESTAPIWAF/RewriteBypassforUserEnumeration(?rest_route=/wp/v2/users)",
              "shortDescription": {
                "text": "REST API WAF/Rewrite Bypass for User Enumeration (?rest_route=/wp/v2/users)"
              },
              "fullDescription": {
                "text": "Path-based blocking on /wp-json/wp/v2/users was bypassed using the query parameter ?rest_route=/wp/v2/users. Disclosed 1 user account(s)."
              },
              "help": {
                "text": "Ensure WAF and rewrite rules inspect both URL paths and query parameters (?rest_route=). Disable the endpoint at application level using the rest_endpoints filter."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "enumeration"
                ]
              }
            },
            {
              "id": "SENTINEL-ENUMERATION-7113",
              "name": "AuthorArchiveUserEnumeration",
              "shortDescription": {
                "text": "Author Archive User Enumeration"
              },
              "fullDescription": {
                "text": "User enumeration via author archives or RSS feeds is possible. Identified 1 public author account(s)."
              },
              "help": {
                "text": "Disable author archives or redirect them. Add to .htaccess: RewriteCond %{QUERY_STRING} ^author= [NC] RewriteRule .* - [F,L]. Alternatively use a plugin to disable author enumeration."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "enumeration"
                ]
              }
            },
            {
              "id": "SENTINEL-EXPOSURE-8947",
              "name": "wp-adminPubliclyAccessible(LoginRequired)",
              "shortDescription": {
                "text": "wp-admin Publicly Accessible (Login Required)"
              },
              "fullDescription": {
                "text": "The /wp-admin/ path is publicly reachable and redirects to login. Consider restricting access by IP or VPN."
              },
              "help": {
                "text": "Restrict /wp-admin/ access via .htaccess IP whitelist, VPN requirement, or a WAF rule. Example: <Files wp-login.php> Order Deny,Allow Deny from all Allow from YOUR_IP </Files>"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "exposure"
                ]
              }
            },
            {
              "id": "SENTINEL-EXPOSURE-3449",
              "name": "install.phpAccessible(AlreadyInstalled)",
              "shortDescription": {
                "text": "install.php Accessible (Already Installed)"
              },
              "fullDescription": {
                "text": "wp-admin/install.php is publicly accessible. While WordPress reports already installed, this endpoint should be blocked."
              },
              "help": {
                "text": "Block access to install.php via .htaccess or server rules."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "exposure"
                ]
              }
            },
            {
              "id": "SENTINEL-INFORMATION_DISCLOSURE-5117",
              "name": "WordPressreadme.htmlAccessible",
              "shortDescription": {
                "text": "WordPress readme.html Accessible"
              },
              "fullDescription": {
                "text": "readme.html is publicly readable and confirms WordPress installation."
              },
              "help": {
                "text": "Delete or block access to readme.html via server configuration."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "information_disclosure"
                ]
              }
            },
            {
              "id": "SENTINEL-INFORMATION_DISCLOSURE-8710",
              "name": "WordPresslicense.txtAccessible",
              "shortDescription": {
                "text": "WordPress license.txt Accessible"
              },
              "fullDescription": {
                "text": "license.txt is publicly readable and confirms WordPress installation. Version reference found: 2"
              },
              "help": {
                "text": "Delete or block access to license.txt via server configuration."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "information_disclosure"
                ]
              }
            },
            {
              "id": "SENTINEL-EXPOSURE-8728",
              "name": "wp-cron.phpPubliclyAccessible",
              "shortDescription": {
                "text": "wp-cron.php Publicly Accessible"
              },
              "fullDescription": {
                "text": "wp-cron.php is accessible. On high-traffic sites this can be used for DoS. It also reveals that WordPress is installed."
              },
              "help": {
                "text": "Disable wp-cron via wp-config.php (define('DISABLE_WP_CRON', true)) and use a system cron job instead. Block public access via .htaccess."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "exposure"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-2444",
              "name": "MissingSecurityHeader:Strict-Transport-Security",
              "shortDescription": {
                "text": "Missing Security Header: Strict-Transport-Security"
              },
              "fullDescription": {
                "text": "HSTS header missing. Browser may allow HTTP connections, enabling MITM attacks. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add header: Strict-Transport-Security: max-age=31536000; includeSubDomains; preload"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-3232",
              "name": "MissingSecurityHeader:Content-Security-Policy",
              "shortDescription": {
                "text": "Missing Security Header: Content-Security-Policy"
              },
              "fullDescription": {
                "text": "CSP header missing. The site is more vulnerable to XSS and injection attacks. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Implement a Content-Security-Policy header appropriate for your site."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-1160",
              "name": "MissingSecurityHeader:X-Content-Type-Options",
              "shortDescription": {
                "text": "Missing Security Header: X-Content-Type-Options"
              },
              "fullDescription": {
                "text": "X-Content-Type-Options header missing. Browser may MIME-sniff responses. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add header: X-Content-Type-Options: nosniff"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-7290",
              "name": "MissingSecurityHeader:X-Frame-Options",
              "shortDescription": {
                "text": "Missing Security Header: X-Frame-Options"
              },
              "fullDescription": {
                "text": "X-Frame-Options header missing. The site may be vulnerable to clickjacking. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add header: X-Frame-Options: DENY (or SAMEORIGIN if framing is needed internally)."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-1333",
              "name": "MissingSecurityHeader:Referrer-Policy",
              "shortDescription": {
                "text": "Missing Security Header: Referrer-Policy"
              },
              "fullDescription": {
                "text": "Referrer-Policy header missing. Full URL may be sent as referrer to third parties. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add header: Referrer-Policy: strict-origin-when-cross-origin"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-0815",
              "name": "MissingSecurityHeader:Permissions-Policy",
              "shortDescription": {
                "text": "Missing Security Header: Permissions-Policy"
              },
              "fullDescription": {
                "text": "Permissions-Policy header missing. Browser features are not explicitly restricted. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add a Permissions-Policy header to restrict unnecessary browser features (camera, microphone, geolocation)."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-9509",
              "name": "MissingSecurityHeader:X-XSS-Protection",
              "shortDescription": {
                "text": "Missing Security Header: X-XSS-Protection"
              },
              "fullDescription": {
                "text": "X-XSS-Protection header missing (relevant for older browsers). (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add header: X-XSS-Protection: 1; mode=block (or 0 if CSP is properly configured)."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-3691",
              "name": "MissingSecurityHeader:Cross-Origin-Opener-Policy",
              "shortDescription": {
                "text": "Missing Security Header: Cross-Origin-Opener-Policy"
              },
              "fullDescription": {
                "text": "Cross-Origin-Opener-Policy (COOP) header missing. Isolates top-level browsing context from cross-origin windows. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add header: Cross-Origin-Opener-Policy: same-origin"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-0533",
              "name": "MissingSecurityHeader:Cross-Origin-Resource-Policy",
              "shortDescription": {
                "text": "Missing Security Header: Cross-Origin-Resource-Policy"
              },
              "fullDescription": {
                "text": "Cross-Origin-Resource-Policy (CORP) header missing. Restricts cross-origin resource reading and embedding. (Note: this is a general hardening recommendation, not a WordPress-specific vulnerability.)"
              },
              "help": {
                "text": "Add header: Cross-Origin-Resource-Policy: same-origin (or same-site)"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-9051",
              "name": "InformationDisclosureHeader:Server",
              "shortDescription": {
                "text": "Information Disclosure Header: Server"
              },
              "fullDescription": {
                "text": "Server header exposes web server software and version. Value: Apache/2.4.57 (Debian)"
              },
              "help": {
                "text": "Remove or obfuscate the Server header in your web server configuration."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-9193",
              "name": "InformationDisclosureHeader:X-Powered-By",
              "shortDescription": {
                "text": "Information Disclosure Header: X-Powered-By"
              },
              "fullDescription": {
                "text": "X-Powered-By header exposes backend technology. Value: PHP/8.2.17"
              },
              "help": {
                "text": "Remove the X-Powered-By header. PHP: expose_php = Off in php.ini."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-HEADERS-2329",
              "name": "ServerBannerRevealsVersionDetails",
              "shortDescription": {
                "text": "Server Banner Reveals Version Details"
              },
              "fullDescription": {
                "text": "The Server header contains version information: 'Apache/2.4.57 (Debian)'. This assists attackers in identifying exploitable software versions."
              },
              "help": {
                "text": "Configure the web server to suppress version numbers. Apache: ServerTokens Prod. Nginx: server_tokens off;"
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "headers"
                ]
              }
            },
            {
              "id": "SENTINEL-ENCRYPTION-1662",
              "name": "SiteNotUsingHTTPS",
              "shortDescription": {
                "text": "Site Not Using HTTPS"
              },
              "fullDescription": {
                "text": "The target URL uses HTTP instead of HTTPS. All traffic is unencrypted."
              },
              "help": {
                "text": "Configure TLS/SSL certificate and redirect all HTTP traffic to HTTPS."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "encryption"
                ]
              }
            },
            {
              "id": "SENTINEL-INFORMATION_DISCLOSURE-5164",
