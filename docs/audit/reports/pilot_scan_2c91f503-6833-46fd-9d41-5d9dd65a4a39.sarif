              "name": "MissingDMARCRecord",
              "shortDescription": {
                "text": "Missing DMARC Record"
              },
              "fullDescription": {
                "text": "Domain 127.0.0.1 is missing a DMARC record. This increases vulnerability to email phishing, spoofing, and brand abuse."
              },
              "help": {
                "text": "Add a TXT record at _dmarc.yourdomain.com with policy settings, e.g., 'v=DMARC1; p=quarantine; pct=100; rua=mailto:security@yourdomain.com'."
              },
              "properties": {
                "tags": [
