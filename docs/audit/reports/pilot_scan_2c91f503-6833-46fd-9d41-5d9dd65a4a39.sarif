            {
              "id": "SENTINEL-CONFIGURATION-4746",
              "name": "CookiesMissingSecureFlag",
              "shortDescription": {
                "text": "Cookies Missing Secure Flag"
              },
              "fullDescription": {
                "text": "The following cookie(s) are missing the 'Secure' flag: wordpress_test_cookie. Cookies without the Secure flag can be transmitted over unencrypted HTTP connections, exposing sensitive data to interception via man-in-the-middle (MITM) attacks."
              },
              "help": {
                "text": "Configure the server to include the 'Secure' attribute for all Set-Cookie headers."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "configuration"
                ]
              }
            },
            {
              "id": "SENTINEL-CONFIGURATION-8759",
              "name": "CookiesMissingHttpOnlyFlag",
              "shortDescription": {
                "text": "Cookies Missing HttpOnly Flag"
              },
              "fullDescription": {
                "text": "The following cookie(s) are missing the 'HttpOnly' flag: wordpress_test_cookie. Cookies without HttpOnly can be accessed by client-side JavaScript, making them vulnerable to theft via Cross-Site Scripting (XSS) attacks."
              },
              "help": {
                "text": "Set the 'HttpOnly' attribute on all cookies, especially session cookies."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "configuration"
                ]
              }
            },
            {
              "id": "SENTINEL-CONFIGURATION-3636",
              "name": "CookiesMissingSameSiteAttribute",
              "shortDescription": {
                "text": "Cookies Missing SameSite Attribute"
              },
              "fullDescription": {
                "text": "The following cookie(s) are missing the 'SameSite' attribute: wordpress_test_cookie. Without SameSite, cookies may be included in cross-site requests, increasing vulnerability to Cross-Site Request Forgery (CSRF) attacks."
              },
              "help": {
                "text": "Set the 'SameSite' attribute ('Strict' or 'Lax') on all cookies."
              },
              "properties": {
                "tags": [
                  "security",
                  "wordpress",
                  "configuration"
                ]
              }
            },
            {
              "id": "SENTINEL-INFORMATION_DISCLOSURE-8608",
