            {
              "id": "SENTINEL-CONFIGURATION-5695",
              "name": "NoWAFDetected",
              "shortDescription": {
                "text": "No WAF Detected"
              },
              "fullDescription": {
                "text": "No Web Application Firewall was detected. The application may be directly exposed to attacks."
              },
              "help": {
