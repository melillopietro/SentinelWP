# SentinelWP Enterprise Environment Configuration Template
ENVIRONMENT=development
WSA_SECRET_KEY=CHANGE_THIS_TO_SECURE_32_CHAR_RANDOM_SECRET_KEY_FOR_PROD

# --- Database Configuration ---
# Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://sentinelwp:secure_db_password@postgres:5432/sentinelwp
# Development / Local Test Fallback:
DATABASE_URL=sqlite:///data/wsa.db

# --- Redis & Celery Message Broker ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Scan Execution Backend ---
# Set to 'celery' for distributed enterprise HA production, or 'local' for local development/tests
SCAN_EXECUTION_BACKEND=local

# --- Scan Governance, Timeouts & Concurrency ---
SCAN_MAX_RETRIES=3
SCAN_SOFT_TIME_LIMIT=1200
SCAN_HARD_TIME_LIMIT=1500
MAX_CONCURRENT_SCANS_PER_TENANT=5
MAX_CONCURRENT_SCANS_PER_ASSET=1
# Phase 7: global scan concurrency ceiling across all tenants
MAX_CONCURRENT_SCANS_GLOBAL=25
SCAN_JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# Phase 7: how often (seconds) the UI polls scan job status
SCAN_STATUS_POLL_SECONDS=5

# --- Audit Log Retention (SEC-005) ---
# Audit events are immutable by default and are NOT automatically purged.
# To enable time-bounded audit log purging, set BOTH variables explicitly.
# AUDIT_LOG_PURGE_ENABLED=false
# AUDIT_LOG_PURGE_RETENTION_DAYS=730

# --- Admin Password Policy (SEC-001) ---
# Minimum password length enforced at setup time (default: 12)
ADMIN_PASSWORD_MIN_LENGTH=12

# --- Evidence Store (Phase 7) ---
# Maximum evidence payload size in bytes (default: 10 MB)
MAX_EVIDENCE_SIZE_BYTES=10485760

# --- Database & Redis Connection Pool Tuning (Phase 7) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
REDIS_POOL_MAX_CONNECTIONS=50

# --- Vulnerability Intelligence Subsystem ---
WORDFENCE_API_KEY=
# Optional: NVD REST API key for higher rate limits (50 req/30s vs 5 req/30s unauthenticated).
# Register at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=your-nvd-api-key-here
NVD_API_KEY=
VULN_INTEL_ENABLED=true
VULN_INTEL_SYNC_INTERVAL_MINUTES=30
INTEL_FRESHNESS_SLA_HOURS=24.0
VULN_INTEL_RETENTION_MONTHS=24
POPULAR_PLUGIN_MIN_ACTIVE_INSTALLS=100000
PLUGIN_METADATA_CACHE_HOURS=168

# --- Distributed Lock Configuration (S3-GAP-001) ---
# When REQUIRE_DISTRIBUTED_LOCK=true, the vulnerability intelligence sync lock
# will FAIL CLOSED if Redis is unreachable rather than silently falling back to
# a process-local threading.Lock. Set to true in multi-worker Celery deployments.
# Leave false (default) for single-process development or test environments.
REQUIRE_DISTRIBUTED_LOCK=false

# --- Intelligence Reassessment Worker (S3-GAP-002) ---
# Number of intel reassessment outbox events processed per task invocation.
# Default: 20. Increase for high-volume deployments.
INTEL_REASSESSMENT_BATCH_SIZE=20
# Maximum event processing retry attempts before moving to DEAD_LETTER state.
INTEL_REASSESSMENT_MAX_RETRIES=3

# --- WordPress Detection Subdirectory Hints (DETECT-OPEN-002) ---
# Comma-separated list of additional subdirectory paths to probe for WordPress
# installations when root-level detection confidence is insufficient.
# The default paths (/blog, /wordpress, /wp, /cms, /site) are always tried.
# Only active in safe-active and full scan modes; never in passive mode.
# WSA_WP_SUBDIR_HINTS=/myapp,/website,/intranet

# --- App Server Configuration ---
PORT=8080
HOST=0.0.0.0
WSA_MAX_SCHEDULE_TARGETS=100
