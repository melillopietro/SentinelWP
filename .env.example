# WSA Pro Enterprise Environment Configuration Template
WSA_ENV=development
WSA_SECRET_KEY=generate_a_random_string_of_at_least_32_characters
WSA_ENCRYPTION_KEY=32_character_aes_encryption_key_here

# SQLite used by default for local development. For production:
# DATABASE_URL=postgresql://wsa_user:wsa_password@db_host:5432/wsa_enterprise
DATABASE_URL=sqlite:///./wsa_enterprise.db

# Redis endpoint for celery tasks and monitoring
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
WSA_RATE_LIMIT_PER_MINUTE=60
WSA_MAX_BATCH_SIZE=10
WSA_DISABLE_TLS_VERIFY=false

# Vulnerability Intelligence
WORDFENCE_API_KEY=
NVD_API_KEY=
VULN_INTEL_ENABLED=true
VULN_INTEL_SYNC_HOURS=24
VULN_INTEL_RETENTION_MONTHS=24
VULN_INTEL_STALE_AFTER_HOURS=48
POPULAR_PLUGIN_MIN_ACTIVE_INSTALLS=100000
PLUGIN_METADATA_CACHE_HOURS=168
